#include <stdio.h>
#include <stdlib.h>

struct node {
    int data;
    struct node *next;
};

struct node *top = NULL;

void push(int x) {
    struct node *newnode;
    newnode = (struct node*) malloc(sizeof(struct node));
    newnode->data = x;
    newnode->next = top;
    top = newnode;
}

void pop() {
    struct node *temp;

    if (top == NULL) {
        printf("Stack Underflow (No elements to pop)\n");
    } else {
        temp = top;
        printf("Popped element: %d\n", top->data);
        top = top->next;
        free(temp);
    }
}

void peek() {
    if (top == NULL) {
        printf("Stack is empty\n");
    } else {
        printf("Top element is: %d\n", top->data);
    }
}

void display() {
    struct node *temp;

    if (top == NULL) {
        printf("Stack is empty\n");
    } else {
        temp = top;
        while (temp != NULL) {
            printf("%d ", temp->data);
            temp = temp->next;
        }
        printf("\n");
    }
}

int main() {

    push(10);
    push(20);
    push(30);

    display();

    pop();
    peek();
    display();

    return 0;
}
